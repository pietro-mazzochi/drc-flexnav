<launch>
	<arg name="robot_load_controller_config" default="$(find-pkg-share drc_flexnav_controllers)/config/robot_load_controller.yaml"/>

	<node name="robot_load_controller_spawner" pkg="controller_manager" exec="spawner"
		args="-t drc_flexnav_controllers/RobotLoadController -p $(var robot_load_controller_config) robot_load_controller"/>
</launch>
