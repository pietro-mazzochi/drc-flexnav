<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="flexnav1500">

    <xacro:arg name="robot" default="flexnav1500" />

    <xacro:include filename="$(find drc_flexnav_description)/xacro/inertial_macros.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/chassis.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/wheel.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/caster_base.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/caster_sphere.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/laser_scanner.xacro" />
    <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/mag.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/imu.urdf.xacro" />


    <!-- ROBOT axis distance -->
    <xacro:property name="base_to_chassi_z" value="0.17235" />
    <!-- <xacro:property name="wheels_distance_y" value="${0.58225-wheel_width/2}" /> -->
    <xacro:property name="wheels_distance_y" value="${0.54725}" />

    <!-- Caster Base to Base link -->
    <xacro:property name="caster_base_x" value="0.74" />
    <xacro:property name="caster_base_y" value="${0.3075}" />
    <!-- <xacro:property name="caster_base_z" value="${0.0394}" /> -->
    <xacro:property name="caster_base_z" value="${0.0394-0.00947*0.9}" />

    <!-- Caster wheel to Caster base -->
    <xacro:property name="caster_base_to_caster_wheel_x" value="${0.035}" />
    <xacro:property name="caster_base_to_caster_wheel_y" value="0.0325" />
    <xacro:property name="caster_base_to_caster_wheel_z" value="${-0.10493}" />


    <!-- Sensors to Base link -->
    <xacro:property name="lidar_to_base_x" value="0.9135" />
    <xacro:property name="lidar_to_base_z" value="${0.10855+0.047}" />

    <xacro:property name="laserScanner_to_base_y" value="0.55108" />
    <xacro:property name="laserScanner_to_base_x" value="0.8715" />
    <xacro:property name="laserScanner_to_base_z" value="${0.03993-0.0505}" />


    <!-- Origin frame -->
    <link name="base_footprint"/>

    <!-- Base link-->
    <link name="base_link"></link>

    <!-- Transform origin -> base_link -->
    <joint name="base_link_to_origin" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
    </joint>

    <!-- MAIN ROBOT DESCRIPTION-->
    <xacro:chassis name="chassis" robot="flexnav1500" parent="base_link">
        <origin xyz="0 0 ${base_to_chassi_z}" rpy="0 0 ${0*pi/2}" />
    </xacro:chassis>

    <!-- Wheels -->
    <xacro:wheel robot="flexnav1500" parent="base_link" prefix="left">
        <origin xyz="0.0 ${wheels_distance_y} 0.0" />
    </xacro:wheel>

    <xacro:wheel robot="flexnav1500" parent="base_link" prefix="right">
        <origin xyz="0.0 -${wheels_distance_y} 0.0" />
    </xacro:wheel>

    <!-- Support Caster Base -->
    <xacro:caster_base robot="flexnav1500" parent="base_link" prefix="front_left">
        <origin xyz="${caster_base_x} ${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <xacro:caster_base robot="flexnav1500" parent="base_link" prefix="front_right">
        <origin xyz="${caster_base_x} -${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <xacro:caster_base robot="flexnav1500" parent="base_link" prefix="rear_left">
        <origin xyz="-${caster_base_x} ${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <xacro:caster_base robot="flexnav1500" parent="base_link" prefix="rear_right">
        <origin xyz="-${caster_base_x} -${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <!-- Caster Wheel -->
    <xacro:caster_wheel robot="flexnav1500" parent="front_left_caster_base" prefix="front_left_1">
        <origin xyz="${caster_base_to_caster_wheel_x} ${0.0} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>

    <xacro:caster_wheel robot="flexnav1500" parent="front_right_caster_base" prefix="front_right_1">
        <origin xyz="${caster_base_to_caster_wheel_x}  ${0.0} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>

    <xacro:caster_wheel robot="flexnav1500" parent="rear_left_caster_base" prefix="rear_left_1">
        <origin xyz="${caster_base_to_caster_wheel_x} ${0.0} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>

    <xacro:caster_wheel robot="flexnav1500" parent="rear_right_caster_base" prefix="rear_right_1">
        <origin xyz="${caster_base_to_caster_wheel_x}  ${0.0} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>


    <!-- <xacro:caster_wheel robot="flexnav1500" parent="front_left_caster_base" prefix="front_left_2">
        <origin xyz="${caster_base_to_caster_wheel_x} ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>

    <xacro:caster_wheel robot="flexnav1500" parent="front_right_caster_base" prefix="front_right_2">
        <origin xyz="${caster_base_to_caster_wheel_x}  ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>

    <xacro:caster_wheel robot="flexnav1500" parent="rear_left_caster_base" prefix="rear_left_2">
        <origin xyz="${caster_base_to_caster_wheel_x} ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel>

    <xacro:caster_wheel robot="flexnav1500" parent="rear_right_caster_base" prefix="rear_right_2">
        <origin xyz="${caster_base_to_caster_wheel_x}  ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}" />
    </xacro:caster_wheel> -->

    <!-- Laser Scanners -->
    <xacro:laser_scan robot="flexnav1500" position="front" yaw="${pi/2}" parent="base_link">
        <origin xyz="${laserScanner_to_base_x} ${laserScanner_to_base_y} ${laserScanner_to_base_z}" />
        <argument>~/out:=front_scan</argument>
        <frame_name>front_laser_scan</frame_name>
    </xacro:laser_scan>

    <xacro:laser_scan robot="flexnav1500" position="rear" yaw="${pi/2}" parent="base_link">
        <origin xyz="-${laserScanner_to_base_x} -${laserScanner_to_base_y} ${laserScanner_to_base_z}" rpy="0.0 0.0 ${pi}" />
        <argument>~/out:=rear_scan</argument>
        <frame_name>rear_laser_scan</frame_name>
    </xacro:laser_scan>

    <!-- LiDARs -->
    <xacro:mid360 name="rear_lidar" parent="base_link" topic="rear_lidar" robot="flexnav1500">
        <origin xyz="-${lidar_to_base_x} 0 ${lidar_to_base_z}" rpy="0 0 ${pi}" />
    </xacro:mid360>

    <xacro:mid360 name="front_lidar" parent="base_link" topic="front_lidar" robot="flexnav1500">
        <origin xyz="${lidar_to_base_x} 0 ${lidar_to_base_z}" rpy="0 0 0" />
    </xacro:mid360>

    <!-- Sensors -->
    <xacro:imu_sensor xyz="0 0 0" rpy="0 0 0" parent="base_link" />
    <xacro:magnetometer_sensor xyz="0.0 0.0 0.0" rpy="0 0 0" parent="base_link" />

    <xacro:include filename="$(find drc_flexnav_description)/xacro/ros2_control.xacro" />


</robot>
    
