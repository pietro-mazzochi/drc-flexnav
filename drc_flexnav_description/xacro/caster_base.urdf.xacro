<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Robot macros: Caster Base -->
    <xacro:macro name="caster_base" params=" robot parent prefix *origin">
        <link name="${prefix}_caster_base">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="2.0" />
                <inertia ixx="0.054289E-1" ixy="-0.000016E-1" ixz="0.003102E-1" iyx="-0.000016E-1" iyy="0.015800E-1" iyz="0.000050E-1" izx="0.003102E-1" izy="0.000050E-1" izz="0.052557E-1" />

            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="file://$(find drc_flexnav_description)/meshes/${robot}/caster_base_cylinder_02993.dae" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh filename="file://$(find drc_flexnav_description)/meshes/${robot}/caster_base_cylinder_02993.dae" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}_caster_base_joint" type="continuous">
            <parent link="${parent}" />
            <child link="${prefix}_caster_base" />
            <xacro:insert_block name="origin" />
            <axis xyz="0 0 1" />
            <dynamics friction= "0.001" damping="0.005"/>
        </joint>

        <!-- <gazebo reference="${prefix}_caster_base">
            <material>Gazebo/FlatBlack</material>
            <mu1>0.08</mu1>
            <mu2>0.08</mu2>
            <kp>100000000.0</kp>
            <kd>10.0</kd>
        </gazebo> -->
    </xacro:macro>

</robot>
