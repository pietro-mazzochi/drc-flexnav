<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="flexnav1500">

    <xacro:arg name="robot" default="flexnav1500" />
    <xacro:arg name="ignition" default="false" />
    <xacro:arg name="ros2_control_hardware_interface" default="false"/>
    <xacro:arg name="sim" default="true" />
    <xacro:arg name="robot" default="flexnav1500" />
    <xacro:arg name="ignition" default="false" />
    <xacro:arg name="lightweight" default="false" />
    <xacro:arg name="rear_lidar_sim" default="true" />
    <xacro:include
        filename="$(find drc_flexnav_description)/xacro/inertial_macros.xacro" />

    <!-- Robot chassis -->
    <xacro:if value="$(arg lightweight)">
        <xacro:include
            filename="$(find drc_flexnav_description)/xacro/chassis_light.urdf.xacro" />
    </xacro:if>

    <xacro:unless value="$(arg lightweight)">
        <xacro:include
            filename="$(find drc_flexnav_description)/xacro/chassis.urdf.xacro"
        />
    </xacro:unless>

    <xacro:include filename="$(find drc_flexnav_description)/xacro/wheel.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/caster_base.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/caster_wheel.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/laser_scanner.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/mag.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/imu.urdf.xacro" />

    <xacro:unless value="$(arg sim)">
        <xacro:include filename="$(find drc_flexnav_description)/xacro/mid360.xacro" />
    </xacro:unless>

    <xacro:if value="$(arg sim)">
        <xacro:unless value="$(arg lightweight)">
            <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />
        </xacro:unless>
        <xacro:if value="$(arg lightweight)">
            <xacro:include filename="$(find drc_flexnav_description)/xacro/mid360_light.xacro" />
        </xacro:if>
    </xacro:if>


    <xacro:include filename="$(find drc_flexnav_description)/xacro/mag.urdf.xacro" />
    <xacro:include filename="$(find drc_flexnav_description)/xacro/imu.urdf.xacro" />


    <!-- ROBOT axis distance -->
    <xacro:property name="base_to_chassi_z" value="0.17235" />
    <!-- <xacro:property name="wheels_distance_y" value="${0.58225-wheel_width/2}" /> -->
    <xacro:property name="wheels_distance_y" value="${0.54725}" />

    <!-- Caster Base to Base link -->
    <xacro:property name="caster_base_x" value="0.74" />
    <xacro:property name="caster_base_y" value="${0.3075}" />
    <!-- <xacro:property name="caster_base_z" value="${0.0394}" /> -->
    <xacro:property name="caster_base_z" value="${0.0394-0.00947*0.925}" />

    <!-- Caster wheel to Caster base -->
    <xacro:property name="caster_base_to_caster_wheel_x" value="${0.035}" />
    <xacro:property name="caster_base_to_caster_wheel_y" value="0.0325" />
    <xacro:property name="caster_base_to_caster_wheel_z" value="${-0.10493}" />


    <!-- Sensors to Base link -->
    <xacro:property name="lidar_to_base_x" value="0.9135" />
    <xacro:property name="lidar_to_base_z" value="${0.10855+0.047}" />

    <xacro:property name="laserScanner_to_base_y" value="0.55108" />
    <xacro:property name="laserScanner_to_base_x" value="0.8715" />
    <xacro:property name="laserScanner_to_base_z" value="${0.03993-0.0505}" />


    <!-- Origin frame -->
    <link name="base_footprint" />

    <!-- Base link-->
    <link name="base_link" />

    <!-- Transform origin -> base_link -->
    <joint name="base_link_to_origin" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.125" rpy="0 0 0" />
    </joint>

    <!-- MAIN ROBOT DESCRIPTION-->
    <xacro:chassis name="chassis" robot="flexnav1500" parent="base_link">
        <origin xyz="0 0 ${base_to_chassi_z}" rpy="0 0 ${0*pi/2}" />
    </xacro:chassis>

    <!-- Wheels -->
    <xacro:wheel robot="flexnav1500" parent="base_link" prefix="left">
        <origin xyz="0.0 ${wheels_distance_y} 0.0" />
    </xacro:wheel>

    <xacro:wheel robot="flexnav1500" parent="base_link" prefix="right">
        <origin xyz="0.0 -${wheels_distance_y} 0.0" />
    </xacro:wheel>

    <!-- Support Caster Base -->
    <xacro:caster_base
        robot="flexnav1500"
        parent="base_link"
        prefix="front_left"
    >
        <origin xyz="${caster_base_x} ${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <xacro:caster_base
        robot="flexnav1500"
        parent="base_link"
        prefix="front_right"
    >
        <origin xyz="${caster_base_x} -${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <xacro:caster_base
        robot="flexnav1500"
        parent="base_link"
        prefix="rear_left"
    >
        <origin xyz="-${caster_base_x} ${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <xacro:caster_base
        robot="flexnav1500"
        parent="base_link"
        prefix="rear_right"
    >
        <origin xyz="-${caster_base_x} -${caster_base_y} ${caster_base_z}" />
    </xacro:caster_base>

    <!-- Caster Wheel -->
    <xacro:caster_wheel
        robot="flexnav1500"
        parent="front_left_caster_base"
        prefix="front_left_1"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x} ${caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <xacro:caster_wheel
        robot="flexnav1500"
        parent="front_right_caster_base"
        prefix="front_right_1"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x}  ${caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <xacro:caster_wheel
        robot="flexnav1500"
        parent="rear_left_caster_base"
        prefix="rear_left_1"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x} ${caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <xacro:caster_wheel
        robot="flexnav1500"
        parent="rear_right_caster_base"
        prefix="rear_right_1"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x}  ${caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>


    <xacro:caster_wheel
        robot="flexnav1500"
        parent="front_left_caster_base"
        prefix="front_left_2"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x} ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <xacro:caster_wheel
        robot="flexnav1500"
        parent="front_right_caster_base"
        prefix="front_right_2"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x}  ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <xacro:caster_wheel
        robot="flexnav1500"
        parent="rear_left_caster_base"
        prefix="rear_left_2"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x} ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <xacro:caster_wheel
        robot="flexnav1500"
        parent="rear_right_caster_base"
        prefix="rear_right_2"
    >
        <origin
            xyz="${caster_base_to_caster_wheel_x}  ${-caster_base_to_caster_wheel_y} ${caster_base_to_caster_wheel_z}"
        />
    </xacro:caster_wheel>

    <!-- Laser Scanners -->
    <xacro:laser_scan
        robot="flexnav1500"
        position="front"
        yaw="${pi/2}"
        parent="base_link"
    >
        <origin
            xyz="${laserScanner_to_base_x} ${laserScanner_to_base_y} ${laserScanner_to_base_z}"
        />
        <argument>~/out:=front_scan</argument>
        <frame_name>front_laser_scan</frame_name>
    </xacro:laser_scan>

    <xacro:laser_scan
        robot="flexnav1500"
        position="rear"
        yaw="${pi/2}"
        parent="base_link"
    >
        <origin
            xyz="-${laserScanner_to_base_x} -${laserScanner_to_base_y} ${laserScanner_to_base_z}"
            rpy="0.0 0.0 ${pi}"
        />
        <argument>~/out:=rear_scan</argument>
        <frame_name>rear_laser_scan</frame_name>
    </xacro:laser_scan>

    <!-- Lidars -->
    <xacro:unless value="$(arg sim)">
        <link name="front_lidar" />
        <joint name="front_lidar_joint" type="fixed">
            <parent link="base_link" />
            <child link="front_lidar" />
            <origin xyz="${lidar_to_base_x} 0 ${lidar_to_base_z}" rpy="0 0 0" />
        </joint>



        <link name="rear_lidar" />
        <joint name="rear_lidar_joint" type="fixed">
            <parent link="base_link" />
            <child link="rear_lidar" />
            <origin
                xyz="-${lidar_to_base_x} 0 ${lidar_to_base_z}"
                rpy="0 0 ${pi}"
            />
        </joint>
    </xacro:unless>


<xacro:if value="$(arg sim)">

<!-- LiDARs -->
    <xacro:if value="$(arg rear_lidar_sim)">
        <xacro:mid360
                name="rear_lidar"
                parent="base_link"
                topic="rear_lidar"
                robot="flexnav1500"
            >
            <origin
                    xyz="-${lidar_to_base_x} 0 ${lidar_to_base_z}"
                    rpy="0 0 ${pi}"
                />
        </xacro:mid360>
    </xacro:if>

    <xacro:mid360
            name="front_lidar"
            parent="base_link"
            topic="front_lidar"
            robot="flexnav1500"
        >
        <origin xyz="${lidar_to_base_x} 0 ${lidar_to_base_z}" rpy="0 0 0" />
    </xacro:mid360>

</xacro:if>

    <!-- Imu/Mag Sensors -->
    <xacro:imu_sensor xyz="0 0 0" rpy="0 0 0" parent="base_link" />
    <xacro:magnetometer_sensor
        xyz="0.0 0.0 0.0"
        rpy="0 0 0"
        parent="base_link"
    />


    <!-- ROS2 Control -->
    <xacro:unless value="$(arg ignition)">
        <xacro:include filename="$(find drc_flexnav_description)/xacro/ros2_control.xacro" />
    </xacro:unless>

    <xacro:if value="$(arg ignition)">
        <xacro:include filename="$(find drc_flexnav_description)/xacro/ignition_ros2_control.xacro" />
    </xacro:if>
</robot>
