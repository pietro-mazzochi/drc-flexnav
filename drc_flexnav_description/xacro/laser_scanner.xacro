<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="laser_scan" params="robot position parent yaw *origin *ros_argument *frame">


        <joint name="${position}_laser_scan_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${position}_laser_scan" />
            <axis xyz="0 0 0" />
        </joint>

        <!-- Link referent to the back laser scanner.-->
        <link name="${position}_laser_scan">
            <visual>
                <origin xyz="0 0 0.0505" rpy="0 0 ${yaw}" />
                <geometry>
                    <mesh filename="file://$(find drc_flexnav_description)/meshes/${robot}/laser_scan.dae" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0.0505" rpy="0 0 ${yaw}" />
                <geometry>
                    <mesh filename="file://$(find drc_flexnav_description)/meshes/${robot}/laser_scan.dae" />
                </geometry>
            </collision>
            <xacro:inertial_box mass="1" x="0.1" y="0.1" z="0.08">
                <origin xyz="0 0 0.0" rpy="0 0 0" />
            </xacro:inertial_box>
        </link>

        <gazebo reference="${position}_laser_scan">
            <sensor name="laser_${position}" type="ray">
                <pose> 0 0 0 0 0 0 </pose>
                <visualize>false</visualize>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <!-- "Scanning angle 275 deg = 4.8 rad" -->
                            <min_angle>-2.4</min_angle>
                            <max_angle>2.4</max_angle>
                            <!-- "Angular resolution 0.17 deg" -->
                            <!-- 275/0.17 = 1617 samples -->
                            <samples>1617</samples>
                        </horizontal>
                    </scan>
                    <range>
                        <!-- "Protective Field 4m, Distance measuring range 40m" -->
                        <min>0.1</min>
                        <max>40</max>
                        <!-- Configurable resolution 0.02/0.03/0.04/0.05/0.07/0.15/0.2 -->
                        <resolution>0.02</resolution>
                    </range>
                </ray>
                <plugin name="${position}_laser_controller" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <xacro:insert_block name="ros_argument" />
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <xacro:insert_block name="frame" />
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>