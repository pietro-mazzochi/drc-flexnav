<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="imu.urdf.xacro"/>
    <xacro:include filename="mag.urdf.xacro"/>

    <xacro:imu_sensor xyz="0 0 0" rpy="0 0 0" parent="base_link"/>
    <xacro:magnetometer_sensor xyz="0.5 0.5 0.5" rpy="0 0 0" parent="base_link"/>


</robot>