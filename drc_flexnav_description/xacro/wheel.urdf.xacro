<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find drc_flexnav_description)/xacro/inertial_macros.xacro" />

    <xacro:property name="wheel_radius" value="0.125" />
    <xacro:property name="wheel_width" value="0.07" />
    <xacro:property name="wheel_mass" value="22.3" />
    <xacro:property name="motor_radius" value="0.125" />
    <xacro:property name="motor_width" value="0.07" />
    <xacro:property name="motor_mass" value="1.0" />

    <xacro:macro name="wheel" params="robot parent prefix *origin">
        <link name="${prefix}_wheel">
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}"
                radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0.0 0.0 0.0" />
            </xacro:inertial_cylinder>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 ${pi/2}" />
                <geometry>
                    <mesh
                        filename="file://$(find drc_flexnav_description)/meshes/${robot}/${prefix}_wheel.dae" />
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>

                    <cylinder radius="${wheel_radius}" length="${wheel_width*0.01}" />
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${parent}" />
            <child link="${prefix}_wheel" />
            <xacro:insert_block name="origin" />
            <axis xyz="0 1 0"/>
            <dynamics friction= "0.1" damping="0.2"/>
        </joint>

        <link name="${prefix}_motor">
      <xacro:inertial_cylinder mass="${motor_mass}" length="${motor_width}"
        radius="${motor_radius}">
                <origin xyz="0 0 0" rpy="0.0 0.0 0.0" />
            </xacro:inertial_cylinder>
        </link>
        <joint name="${prefix}_motor_joint" type="continuous">
            <parent link="${parent}" />
            <child link="${prefix}_motor" />
            <xacro:insert_block name="origin" />
            <axis xyz="0 1 0"/>
        </joint>

        <transmission name="${prefix}_transmission">
            <type>transmission_interface/SimpleTransmission"</type>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}_actuator">
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/FlatBlack</material>
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
            <kp>100000000.0</kp>
            <kd>10.0</kd>
            <!-- <minDepth>0.005</minDepth> -->
            <!--
             <maxVel>0.1</maxVel>
             <fdir1>1 0 0</fdir1>
         -->
        </gazebo>

    </xacro:macro>

</robot>
