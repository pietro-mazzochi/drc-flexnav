<?xml version="1.0" ?>
<robot name="imu_mag_robot">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- IMU Sensor Plugin -->
  <gazebo reference="base_link">
      <gravity>true</gravity>
      <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <visualize>true</visualize>
          <topic>__default_topic__</topic>
          <imu>
              <angular_velocity>
                  <x>
                  <noise type="gaussian">
                      <mean>0.0</mean>
                      <stddev>0.635e-3</stddev>
                      <bias_mean>0.0</bias_mean>
                      <bias_stddev>0.0</bias_stddev>
                  </noise>
                  </x>
                  <y>
                  <noise type="gaussian">
                      <mean>0.0</mean>
                      <stddev>0.635e-3</stddev>
                      <bias_mean>0.0</bias_mean>
                      <bias_stddev>0.0</bias_stddev>
                  </noise>
                  </y>
                  <z>
                  <noise type="gaussian">
                      <mean>0.0</mean>
                      <stddev>0.635e-3</stddev>
                      <bias_mean>0.0</bias_mean>
                      <bias_stddev>0.0</bias_stddev>
                  </noise>
                  </z>
              </angular_velocity>
              <linear_acceleration>
                  <x>
                  <noise type="gaussian">
                      <mean>0.0</mean>
                      <stddev>100.1e-6</stddev>
                      <bias_mean>0</bias_mean>
                      <bias_stddev>0</bias_stddev>
                  </noise>
                  </x>
                  <y>
                  <noise type="gaussian">
                      <mean>0.0</mean>
                      <stddev>100.1e-6</stddev>
                      <bias_mean>0.0</bias_mean>
                      <bias_stddev>0.0</bias_stddev>
                  </noise>
                  </y>
                  <z>
                  <noise type="gaussian">
                      <mean>0.0</mean>
                      <stddev>100.1e-6</stddev>
                      <bias_mean>0.0</bias_mean>
                      <bias_stddev>0.0</bias_stddev>
                  </noise>
                  </z>
              </linear_acceleration>
            </imu>
          <plugin filename="libgazebo_ros_imu_sensor.so" name="imu">
              <topicName>imu</topicName>
              <bodyName>base_link</bodyName>
              <updateRateHZ>10.0</updateRateHZ>
              <!-- <gaussianNoise>0.0</gaussianNoise> -->
              <!-- <xyzOffset>0 0 0</xyzOffset> -->
              <!-- <rpyOffset>0 0 0</rpyOffset> -->
              <frameName>base_link</frameName>
              <initialOrientationAsReference>false</initialOrientationAsReference>
          </plugin>
          <pose>0 0 0 0 0 0</pose>
      </sensor>
  </gazebo>
        <!-- Magnetometer Sensor Plugin -->
    <!-- <plugin name="magnetometer_sensor" filename="libgmagnetometer_plugin.so">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <body_name>base_link</body_name>
      <topic_name>magnetometer/data</topic_name>
    </plugin> -->

   
</robot>
