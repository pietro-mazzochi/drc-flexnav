<launch>
	<arg name="use_sim_time" default="false"/>
	<arg name="config" default="$(find-pkg-share drc_flexnav_bringup)/config/odometry_publisher.yaml"/>

	<node pkg="odometry_arc" exec="odometry_publisher" name="odometry_publisher">
		<param from="$(var config)"/>
		<param name="use_sim_time" value="$(var use_sim_time)"/>
	</node>

</launch>