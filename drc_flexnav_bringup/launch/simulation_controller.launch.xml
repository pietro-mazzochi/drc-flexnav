<launch>
    <arg name="pause" default="false" />
    <arg name="gui" default="true" />
    <arg name="use_sim_time" default="true" />
    <arg name="world" default="empty" />
    <arg name="robot" default="flexnav1500" />
    <arg name="controller" default="joint_effort_controller" />
    <arg name="odom" default="true" />
    <arg
        name="config"
        default="$(find-pkg-share drc_flexnav_bringup)/config/$(var controller).yaml"
    />
	<arg
        name="odom_config"
        default="$(find-pkg-share drc_flexnav_bringup)/config/odometry_publisher.yaml"
    />
    <arg name="engine" default="gazebo" />
    <arg name="x" default="0.0" />
    <arg name="y" default="-1.5" />
    <arg name="z" default="0.1" />
    <arg name="Y" default="3.14" />
    <arg name="config_rviz" default="default" />
    <arg name="lightweight" default="false" />
    <arg name="rear_lidar_sim" default="true" />
    <arg name="base2joint_velocity_converter_config_file" default="$(find-pkg-share drc_flexnav_bringup)/config/joint_velocity_converter_real_robot_hw_interface_with_pid.yaml" />


    <group>
        <include
            file="$(find-pkg-share drc_simulation)/launch/$(var engine).launch.xml"
        >
            <arg name="pause" value="$(var pause)" />
            <arg name="gui" value="$(var gui)" />
            <arg name="use_sim_time" value="$(var use_sim_time)" />
            <arg name="lightweight" value="$(var lightweight)" />
            <arg name="rear_lidar_sim" value="$(var rear_lidar_sim)" />
            <arg name="world" value="$(var world)" />
        </include>

        <include
            file="$(find-pkg-share drc_flexnav_bringup)/launch/$(var controller).launch.xml"
        >
            <arg name="config" value="$(var config)" />
            <arg name="use_sim_time" value="$(var use_sim_time)" />
        </include>
        <node
            pkg="rviz2"
            exec="rviz2"
            name="rviz2"
            args="-d $(find-pkg-share drc_flexnav_bringup)/rviz/$(var config_rviz).rviz"
        >
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
    </group>
    <group>
        <include
            file="$(find-pkg-share base2joint_velocity_converter)/launch/joint_velocity_broadcaster_node.launch.xml"
        />
        <include
            file="$(find-pkg-share base2joint_velocity_converter)/launch/velocity_converter_node.launch.xml"
        >
            <arg name="config_file" value="$(var base2joint_velocity_converter_config_file)" />
      
        </include>
    </group>

    <include
        file="$(find-pkg-share drc_flexnav_bringup)/launch/flexnav1500_digital_pid_controller.launch.xml"
    />

    <include
        file="$(find-pkg-share joystick_controller)/launch/joystick_control.launch.xml"
    />

	<node
        pkg="odometry_arc"
        exec="odometry_publisher"
        name="odometry_publisher"
        if="$(var odom)"
    >
		<param from="$(var odom_config)" />
		<param name="use_sim_time" value="$(var use_sim_time)" />
	</node>

</launch>
