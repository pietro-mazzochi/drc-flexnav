<launch>
    <arg name="config" default="$(find-pkg-share drc_flexnav_bringup)/config/joint_effort_controller.yaml" />

    <node name="left_wheel_controller_spawner" pkg="controller_manager" exec="spawner" args="-t forward_command_controller/ForwardCommandController -p $(var config) --controller-manager-timeout 90 left_wheel_joint_effort_controller" />

    <node name="right_wheel_controller_spawner" pkg="controller_manager" exec="spawner" args="-t forward_command_controller/ForwardCommandController -p $(var config) --controller-manager-timeout 90 right_wheel_joint_effort_controller" />

    <node name="joint_state_broadcaster_spawner" pkg="controller_manager" exec="spawner" args="-t joint_state_broadcaster/JointStateBroadcaster -p $(var config) --controller-manager-timeout 90 joint_state_broadcaster" />
</launch>
 