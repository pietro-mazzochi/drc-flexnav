<launch>
    <arg name="config" default="$(find-pkg-share drc_flexnav_bringup)/config/joint_velocity_controller.yaml" />

    <node name="left_wheel_controller_spawner" pkg="controller_manager" exec="spawner" args="-t forward_command_controller/ForwardCommandController -p $(var config) left_wheel_velocity_controller" />

    <node name="right_wheel_controller_spawner" pkg="controller_manager" exec="spawner" args="-t forward_command_controller/ForwardCommandController -p $(var config) right_wheel_velocity_controller" />

    <node name="joint_state_broadcaster_spawner" pkg="controller_manager" exec="spawner" args="-t joint_state_broadcaster/JointStateBroadcaster -p $(var config) joint_state_broadcaster" />
</launch>
 